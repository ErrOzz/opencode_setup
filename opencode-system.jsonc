// OpenCode 2.x: SYSTEM config, security rules only.
// Deployed to: %ProgramData%\opencode\opencode.json (installed by
// install.ps1, synced from this repo file on every run - DO NOT hand-edit
// the deployed copy, your changes will be overwritten on the next update).
//
// For machine-specific additions or exceptions (e.g. extra allowed paths),
// edit %ProgramData%\opencode\opencode.jsonc instead - that file is created
// once and the installer never touches it again. See the comments in that
// file (and in install.ps1) for why it has to be the .jsonc one, not this
// one, if you want an exception to actually override a rule from here.
//
// This managed layer has the highest priority: project-level config cannot
// override it, and the agent cannot rewrite it without elevated rights.
// Provider and model settings live in the global config
// (~\.config\opencode\opencode.jsonc) - keep permissions/policies here
// (and in the local additions file), do not duplicate them elsewhere.
//
// permissions: rules that ask for confirmation. The LAST matching rule in
// the final merged list wins, so narrower exceptions must load after the
// broader rule they narrow.
// policies: hard denials, no prompt.
// This is not a sandbox: the agent runs with your own account's rights.
{
  "$schema": "https://opencode.ai/config.json",

  "permissions": [
    // Shell commands: ask, except safe read-only git inspection.
    { "action": "shell", "resource": "*", "effect": "ask" },
    { "action": "shell", "resource": "git status *", "effect": "allow" },
    { "action": "shell", "resource": "git diff *", "effect": "allow" },
    { "action": "shell", "resource": "git log *", "effect": "allow" },

    // Leaving the project folder: ask.
    { "action": "external_directory", "resource": "*", "effect": "ask" },

    // Network access: ask (remove this line if it gets in the way).
    // { "action": "webfetch", "resource": "*", "effect": "ask" },

    // Secrets: reading .env is denied, example files without values are fine.
    { "action": "read", "resource": "*.env", "effect": "deny" },
    { "action": "read", "resource": "*.env.*", "effect": "deny" },
    { "action": "read", "resource": "*.env.example", "effect": "allow" }
  ],

  "policies": [
    // .env and examples (the allow only narrows the broader deny above)
    { "action": "tool.use", "resource": "read:*.env", "effect": "deny" },
    { "action": "tool.use", "resource": "read:*.env.*", "effect": "deny" },
    { "action": "tool.use", "resource": "read:*.env.example", "effect": "allow" },
    { "action": "tool.use", "resource": "edit:*.env", "effect": "deny" },

    // Keys and credentials
    { "action": "tool.use", "resource": "read:*.pem", "effect": "deny" },
    { "action": "tool.use", "resource": "read:*.key", "effect": "deny" },
    { "action": "tool.use", "resource": "read:*.pfx", "effect": "deny" },
    { "action": "tool.use", "resource": "read:*/.ssh/*", "effect": "deny" },
    { "action": "tool.use", "resource": "read:*/.aws/*", "effect": "deny" },
    { "action": "tool.use", "resource": "read:*/.git-credentials", "effect": "deny" },
    { "action": "tool.use", "resource": "read:*/.netrc", "effect": "deny" },

    // OpenCode's own data: stored keys, legacy auth.json, service config.
    // Cross-check these paths with `opencode debug paths`.
    { "action": "tool.use", "resource": "read:*/.local/share/opencode/*", "effect": "deny" },
    { "action": "tool.use", "resource": "read:*/.config/opencode/service.json", "effect": "deny" }
  ]
}

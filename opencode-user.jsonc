// OpenCode 2.x: GLOBAL user config with the RouterAI provider skeleton and custom agents.
// Models are managed by the routerai-models skill (add / update / remove).
// Location: %USERPROFILE%\.config\opencode\opencode.json (the file is named opencode.json there).
// Security rules (permissions, policies) live in the system-wide file
// %ProgramData%\opencode\opencode.jsonc; do not duplicate them here.
//
// The API key is a saved OpenCode account (opencode auth login routerai --method key);
// it is not stored in this file.
//
// "~...-latest" aliases move to new model versions automatically. The version in
// parentheses is the one current on the date above. For reproducibility you can
// add pinned model IDs.
{
  "$schema": "https://opencode.ai/config.json",

  "providers": {
    "routerai": {
      "name": "RouterAI",
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "https://routerai.ru/api/v1"
      },
            "models": {}
    }
  }
}
